<?xml version="1.0" encoding="utf-8"?>
<androidx.swiperefreshlayout.widget.SwipeRefreshLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/swipe"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:id="@+id/scroll"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:clipToPadding="false">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingTop="12dp"
            android:paddingEnd="16dp"
            android:paddingBottom="32dp">

            <!-- Адреси: чип активної + інші + «Додати» -->
            <HorizontalScrollView
                android:id="@+id/addr_scroll"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="8dp"
                android:clipToPadding="false"
                android:scrollbars="none">

                <LinearLayout
                    android:id="@+id/addr_chips"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal" />
            </HorizontalScrollView>

            <!-- Адреса й черга -->
            <TextView
                android:id="@+id/address"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingStart="8dp"
                android:paddingBottom="12dp"
                android:fontFamily="sans-serif-medium"
                android:textColor="@color/text2"
                android:textSize="13sp" />

            <!-- Головна картка -->
            <LinearLayout
                android:id="@+id/hero_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="24dp">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <View
                        android:id="@+id/status_dot"
                        android:layout_width="10dp"
                        android:layout_height="10dp"
                        android:background="@drawable/pill" />

                    <TextView
                        android:id="@+id/status_label"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="10dp"
                        android:fontFamily="sans-serif-medium"
                        android:letterSpacing="0.08"
                        android:textColor="@color/text"
                        android:textSize="14sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/big_time"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:fontFamily="sans-serif-light"
                    android:includeFontPadding="false"
                    android:textColor="@color/text"
                    android:textSize="72sp" />

                <TextView
                    android:id="@+id/caption"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:textColor="@color/text2"
                    android:textSize="17sp" />

                <TextView
                    android:id="@+id/share"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:background="@drawable/pill"
                    android:backgroundTint="@color/badge_soft"
                    android:fontFamily="sans-serif-medium"
                    android:paddingStart="16dp"
                    android:paddingTop="8dp"
                    android:paddingEnd="16dp"
                    android:paddingBottom="8dp"
                    android:text="Поділитися графіком"
                    android:textColor="@color/text"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Пояснення дозволів: зникає, коли все дозволено або «Пізніше» -->
            <LinearLayout
                android:id="@+id/perm_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Щоб графік був під рукою"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/perm_notif_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Сповіщення — графік на заблокованому екрані й нагадування перед відключенням."
                    android:textColor="@color/text2"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/perm_notif"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_primary"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="Дозволити сповіщення"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/perm_battery_text"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="16dp"
                    android:lineSpacingExtra="2dp"
                    android:text="Робота у фоні — інакше телефон «приспить» застосунок, графік перестане оновлюватись, а нагадування запізнюватимуться. Знайдіть «Світло» у списку й вимкніть для нього оптимізацію батареї."
                    android:textColor="@color/text2"
                    android:textSize="14sp" />

                <Button
                    android:id="@+id/perm_battery"
                    android:layout_width="match_parent"
                    android:layout_height="48dp"
                    android:layout_marginTop="10dp"
                    android:background="@drawable/btn_primary"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="Дозволити роботу у фоні"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/perm_later"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:layout_marginTop="8dp"
                    android:padding="8dp"
                    android:text="Пізніше"
                    android:textColor="@color/text2"
                    android:textSize="14sp" />
            </LinearLayout>

            <!-- Сьогодні -->
            <LinearLayout
                android:id="@+id/today_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/today_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/today_total"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text2"
                        android:textSize="13sp" />
                </LinearLayout>

                <ua.odin.svitlo.DayTimelineView
                    android:id="@+id/today_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <LinearLayout
                    android:id="@+id/today_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Завтра -->
            <LinearLayout
                android:id="@+id/tomorrow_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/tomorrow_title"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:fontFamily="sans-serif-medium"
                        android:textColor="@color/text"
                        android:textSize="18sp" />

                    <TextView
                        android:id="@+id/tomorrow_total"
                        android:layout_marginTop="2dp"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:textColor="@color/text2"
                        android:textSize="13sp" />
                </LinearLayout>

                <ua.odin.svitlo.DayTimelineView
                    android:id="@+id/tomorrow_timeline"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp" />

                <TextView
                    android:id="@+id/tomorrow_empty"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="Графік на завтра ДТЕК ще не опублікував"
                    android:textColor="@color/text2"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/tomorrow_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:orientation="vertical" />
            </LinearLayout>

            <!-- Статистика -->
            <LinearLayout
                android:id="@+id/stats_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:fontFamily="sans-serif-medium"
                    android:text="Скільки світла щодня"
                    android:textColor="@color/text"
                    android:textSize="18sp" />

                <TextView
                    android:id="@+id/stats_summary"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="2dp"
                    android:textColor="@color/text2"
                    android:textSize="13sp" />

                <LinearLayout
                    android:id="@+id/stats_list"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="vertical" />

                <TextView
                    android:id="@+id/stats_hint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Історія за минулі дні накопичуватиметься з кожним днем"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <!-- Легенда -->
            <LinearLayout
                android:id="@+id/legend"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                android:gravity="center"
                android:orientation="horizontal">

                <View
                    android:id="@+id/legend_on"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/pill" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="16dp"
                    android:text="Світло є"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/legend_off"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/pill" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:layout_marginEnd="16dp"
                    android:text="Немає"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />

                <View
                    android:id="@+id/legend_maybe"
                    android:layout_width="12dp"
                    android:layout_height="12dp"
                    android:background="@drawable/pill" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="6dp"
                    android:text="Можливо"
                    android:textColor="@color/text2"
                    android:textSize="12sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/info"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="12dp"
                android:gravity="center"
                android:lineSpacingExtra="2dp"
                android:textColor="@color/text2"
                android:textSize="12sp" />

            <!-- Налаштування -->
            <TextView
                android:id="@+id/settings_toggle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="20dp"
                android:background="@drawable/card_bg"
                android:fontFamily="sans-serif-medium"
                android:padding="18dp"
                android:text="Адреса й налаштування  ▾"
                android:textColor="@color/text"
                android:textSize="15sp" />

            <LinearLayout
                android:id="@+id/settings"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:background="@drawable/card_bg"
                android:orientation="vertical"
                android:padding="20dp"
                android:visibility="gone">

                <RadioGroup
                    android:id="@+id/region"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="8dp"
                    android:orientation="horizontal">

                    <RadioButton
                        android:id="@+id/region_kyiv"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:minHeight="48dp"
                        android:text="Київ"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <RadioButton
                        android:id="@+id/region_oblast"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1.4"
                        android:minHeight="48dp"
                        android:text="Київська область"
                        android:textColor="@color/text"
                        android:textSize="15sp" />
                </RadioGroup>

                <AutoCompleteTextView
                    android:id="@+id/city"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginBottom="8dp"
                    android:background="@drawable/field_bg"
                    android:completionThreshold="2"
                    android:dropDownVerticalOffset="6dp"
                    android:hint="Населений пункт, напр. Бровари"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text2"
                    android:visibility="gone" />

                <AutoCompleteTextView
                    android:id="@+id/street"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:background="@drawable/field_bg"
                    android:completionThreshold="2"
                    android:dropDownVerticalOffset="6dp"
                    android:hint="Почніть вводити назву вулиці"
                    android:imeOptions="actionNext"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text2" />

                <AutoCompleteTextView
                    android:id="@+id/house"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/field_bg"
                    android:completionThreshold="1"
                    android:dropDownVerticalOffset="6dp"
                    android:enabled="false"
                    android:hint="Спершу оберіть вулицю"
                    android:imeOptions="actionDone"
                    android:inputType="textNoSuggestions"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text2" />

                <EditText
                    android:id="@+id/addr_name"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="8dp"
                    android:background="@drawable/field_bg"
                    android:hint="Назва, напр. Дім або Робота (необов’язково)"
                    android:imeOptions="actionDone"
                    android:inputType="textCapSentences"
                    android:maxLength="24"
                    android:maxLines="1"
                    android:paddingStart="16dp"
                    android:paddingEnd="16dp"
                    android:textColor="@color/text"
                    android:textColorHint="@color/text2"
                    android:visibility="gone" />

                <Button
                    android:id="@+id/save"
                    android:layout_width="match_parent"
                    android:layout_height="52dp"
                    android:layout_marginTop="14dp"
                    android:background="@drawable/btn_primary"
                    android:fontFamily="sans-serif-medium"
                    android:stateListAnimator="@null"
                    android:text="Зберегти й оновити"
                    android:textAllCaps="false"
                    android:textColor="@color/button_text"
                    android:textSize="16sp" />

                <TextView
                    android:id="@+id/delete_addr"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:layout_marginTop="6dp"
                    android:padding="10dp"
                    android:text="Видалити цю адресу"
                    android:textColor="@color/text2"
                    android:textSize="14sp"
                    android:visibility="gone" />

                <LinearLayout
                    android:id="@+id/extra_settings"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="22dp"
                        android:fontFamily="sans-serif-medium"
                        android:text="Нагадування"
                        android:textColor="@color/text"
                        android:textSize="16sp" />

                    <Switch
                        android:id="@+id/remind_off"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Перед відключенням"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <RadioGroup
                        android:id="@+id/lead"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <RadioButton
                            android:id="@+id/lead15"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="за 15 хв"
                            android:textColor="@color/text2" />

                        <RadioButton
                            android:id="@+id/lead30"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="за 30 хв"
                            android:textColor="@color/text2" />

                        <RadioButton
                            android:id="@+id/lead60"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="за 1 год"
                            android:textColor="@color/text2" />
                    </RadioGroup>

                    <Switch
                        android:id="@+id/remind_on"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Перед увімкненням"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/notify_changes"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Коли змінюється графік"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/quiet_night"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Тихо вночі (23:00–07:00)"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <Switch
                        android:id="@+id/reminder_sound"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:minHeight="48dp"
                        android:text="Звук нагадувань"
                        android:textColor="@color/text"
                        android:textSize="15sp" />

                    <Button
                        android:id="@+id/battery"
                        style="?android:attr/borderlessButtonStyle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="4dp"
                        android:textAllCaps="false"
                        android:textColor="@color/text2" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>
    </ScrollView>
</androidx.swiperefreshlayout.widget.SwipeRefreshLayout>
